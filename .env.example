# Run python3 scripts/setup.py to create .env and private credentials.
# Public example: Pasadena City Hall, California; not a private residence.
BIND_ADDRESS=127.0.0.1
PORT=8090
TZ=America/Los_Angeles
HOME_LAT=34.1478
HOME_LON=-118.1436
LOCATION_LABEL=PASADENA
REGION_LABEL=CALIFORNIA
# Both destination fields are optional. Traffic also needs a TomTom key.
WORK_LAT=
WORK_LON=
REFRESH_SECONDS=3600
MAP_ENABLED=true
# The host firewall script must use this same bridge prefix.
BRIDGE_PREFIX=br-bboard
